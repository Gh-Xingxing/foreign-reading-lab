# Local database path. Defaults to ./data/reading_lab.sqlite3
FOREIGN_READING_DB=./data/reading_lab.sqlite3

# mock: offline demo mode. online: call an OpenAI-compatible chat completions API.
FOREIGN_READING_AI_MODE=mock
FOREIGN_READING_API_KEY=
FOREIGN_READING_API_BASE=https://api.openai.com/v1
FOREIGN_READING_MODEL=gpt-4o-mini

# Optional placeholder for future hosted TTS generation.
# The current product uses browser Web Speech for offline reading aloud.
FOREIGN_READING_TTS_ENDPOINT=

# Local server address.
HOST=127.0.0.1
PORT=5178

